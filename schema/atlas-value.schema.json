{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-value/1",
  "title": "Atlas value record",
  "description": "One value figure set for a project stage. The basis decides how it may be shown: a measured record must carry a source, and a not-tracked record carries no numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "projectId",
    "basis",
    "period",
    "tier",
    "hours",
    "cost",
    "errorRate",
    "volume",
    "targetHours",
    "targetCost",
    "method",
    "methodVersion",
    "confidence",
    "sourceRef",
    "notes",
    "createdAt"
  ],
  "properties": {
    "contract": { "const": "atlas-value/1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "basis": { "enum": ["estimate", "measured", "not-tracked"] },
    "period": { "enum": ["baseline", "d30", "d90"] },
    "tier": { "type": ["string", "null"], "maxLength": 60 },
    "hours": { "type": ["number", "null"], "minimum": 0 },
    "cost": { "type": ["number", "null"], "minimum": 0 },
    "errorRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "volume": { "type": ["number", "null"], "minimum": 0 },
    "targetHours": { "type": ["number", "null"], "minimum": 0 },
    "targetCost": { "type": ["number", "null"], "minimum": 0 },
    "method": { "type": "string", "minLength": 1, "maxLength": 120 },
    "methodVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "confidence": { "enum": ["low", "medium", "high", "unknown"] },
    "sourceRef": { "type": ["string", "null"], "maxLength": 2000 },
    "notes": { "type": "string", "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
