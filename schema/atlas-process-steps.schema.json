{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-process-steps/1",
  "title": "Atlas process steps",
  "description": "The steps of a process, as KG extracts them and as a person edits them. The source's own labels are kept, never renumbered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "projectId", "provenance", "source", "steps", "createdAt"],
  "properties": {
    "contract": { "const": "atlas-process-steps/1" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "provenance": { "enum": ["kg", "atlas", "manual"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "documentType"],
      "properties": {
        "filename": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "documentType": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "action", "actor", "inputs", "outputs", "notes"],
        "properties": {
          "number": { "type": "string", "minLength": 1, "maxLength": 20 },
          "action": { "type": "string", "minLength": 1, "maxLength": 500 },
          "actor": { "type": ["string", "null"], "maxLength": 120 },
          "inputs": { "type": ["string", "null"], "maxLength": 300 },
          "outputs": { "type": ["string", "null"], "maxLength": 300 },
          "notes": { "type": ["string", "null"], "maxLength": 300 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
